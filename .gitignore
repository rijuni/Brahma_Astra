# Root .gitignore for BRAHMA + ASTRA

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Databases
*.db
*.db-journal
*.sqlite
*.sqlite3
dev.db
dev.db-journal
test.db
test.db-journal

# Prisma
services/api/prisma/*.db
services/api/prisma/*.db-journal

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDE & OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ASTRA runner scratch & workspaces
services/astra-runner/workspaces/
services/astra-runner/tmp/
scratch/
