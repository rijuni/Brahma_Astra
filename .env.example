# ==============================================================================
# BRAHMA + ASTRA Environment Configuration Example (Native Windows Development)
# Copy this file to .env or services/api/.env for local development.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application API (Node.js + Express)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database (Prisma)
# ------------------------------------------------------------------------------
# Default native development database is SQLite:
DATABASE_URL="file:./dev.db"
# Target integration testing and production database (optional for local dev):
# DATABASE_URL="postgresql://brahma_user:replace_secure_password@localhost:5432/brahma_astra?schema=public"

# ------------------------------------------------------------------------------
# Authentication & Sessions
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# Shared Internal Service-to-Service Authentication
# ------------------------------------------------------------------------------
# Used to authenticate requests between Express, Brahma Core, Astra Engine, and Astra Runner
INTERNAL_SERVICE_KEY=dev_internal_service_key_change_in_production

# ------------------------------------------------------------------------------
# BRAHMA Core (Python + FastAPI)
# ------------------------------------------------------------------------------
BRAHMA_CORE_PORT=8001
BRAHMA_CORE_URL=http://localhost:8001
# Provider options: mock (default, zero credentials), openai, anthropic, gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# ASTRA Engine (Python + FastAPI)
# ------------------------------------------------------------------------------
ASTRA_ENGINE_PORT=8002
ASTRA_ENGINE_URL=http://localhost:8002

# ------------------------------------------------------------------------------
# ASTRA Runner (Execution Boundary)
# ------------------------------------------------------------------------------
ASTRA_RUNNER_PORT=8003
ASTRA_RUNNER_URL=http://localhost:8003
# Execution mode: "disabled" is the MANDATORY secure default on native Windows.
# Arbitrary user code is not executed without a verified hardware/container sandbox.
RUNNER_EXECUTION_MODE=disabled
RUNNER_MAX_TIMEOUT_SECONDS=15
RUNNER_MAX_MEMORY_MB=256
RUNNER_MAX_OUTPUT_BYTES=32768

# ------------------------------------------------------------------------------
# Redis (Optional for local development)
# ------------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
